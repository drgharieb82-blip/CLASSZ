PROJECT_NAME=CLASSZ
ENVIRONMENT=local
API_VERSION=0.1.0
API_PREFIX=/api

POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=classz
POSTGRES_PASSWORD=classz
POSTGRES_DB=classz
DATABASE_URL=postgresql://classz:classz@postgres:5432/classz

JWT_SECRET_KEY=replace-with-a-long-random-production-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

BACKEND_PORT=8000
FRONTEND_PORT=5173
